# Caddy сам получает и продлевает бесплатный сертификат Let's Encrypt на
# {$DOMAIN} (например 51-250-10-20.sslip.io или свой домен) - Telegram
# открывает мини-аппы только по https.
{$DOMAIN} {
	encode gzip
	reverse_proxy api:8000
}

# Проверка связи для поддержки: http://<IP сервера> - без имени, без DNS и без
# сертификата. Если у пользователя (например, с VPN) мини-апп не открывается,
# эта страница отличает "до сервера не доходит" от "не находится имя".
http:// {
	header Content-Type "text/plain; charset=utf-8"
	respond "HonestLot: связь с сервером есть" 200
}
