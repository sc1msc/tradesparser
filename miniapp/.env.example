# Скопируйте в miniapp/.env на сервере и заполните. В git не хранится.

# Имя сервера для HTTPS - на него Caddy сам получает сертификат. A-запись домена
# (DNS у SpaceWeb) должна указывать на IP ВМ. Несколько имён - через запятую С ПРОБЕЛОМ
# и в кавычках: DOMAIN="honestlot.ru, other.ru" (без пробела Caddy не запустится).
DOMAIN=honestlot.ru

# Токен бота @honestlot_bot от @BotFather - им проверяется подпись Telegram
HONESTLOT_BOT_TOKEN=

# Релей для Telegram Bot API: с ВМ api.telegram.org недоступен, бот ходит через
# VPS в Амстердаме (relay/setup.sh). Без переменной - напрямую в Telegram.
HONESTLOT_TELEGRAM_API=https://tg.honestlot.ru

# Длинный случайный ключ для загрузки лотов с ПК. Тот же - в local_secrets.py
# как MINIAPP_IMPORT_TOKEN. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
HONESTLOT_IMPORT_TOKEN=

# Telegram id администратора: если выгрузки с ПК не было больше 36 часов, сервер
# пишет ему через @honestlot_bot (app/watchdog.py). Получатель должен хотя бы раз
# нажать "Старт" у @honestlot_bot. Пусто - сторож выключен.
HONESTLOT_ADMIN_CHAT_ID=
# Бот уведомлений администратору (сторож, статусы, сбор лотов, пайплайн с ПК через /api/notify).
# Пусто - уведомления идут через основного бота. Получатель должен нажать у бота «Старт».
HONESTLOT_NOTIFY_BOT_TOKEN=

# ---- Приём оплаты подписки (app/billing.py, wiki/payments.md). По умолчанию выключен:
# без HONESTLOT_PAYMENTS_ENABLED=1 страницы /pay и /api/pay/* отвечают 404.
HONESTLOT_PAYMENTS_ENABLED=
# yookassa | fake (fake - тестовая оплата без денег, только для локальной проверки)
HONESTLOT_PAY_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 - передавать в ЮKassa данные для чека (54-ФЗ, если чеки бьёт ЮKassa); самозанятому
# с чеками НПД через "Мой налог" - пусто
HONESTLOT_PAY_RECEIPTS=
# Адрес сайта для return_url и ссылок в письмах
HONESTLOT_SITE_URL=https://honestlot.ru
# Ключ подписи ссылок управления подпиской из писем. Пусто - выводится из токена бота
# (тогда смена токена бота сделает старые ссылки недействительными)
HONESTLOT_LINK_SECRET=
# Почта для писем подписчикам - Yandex Cloud Postbox (wiki/payments.md, "Почта").
# Порт: 465 - SSL, иначе STARTTLS. USER - id API-ключа сервисного аккаунта с ролью
# postbox.sender, PASSWORD - секретная часть этого ключа. Проверка:
# docker compose exec api python -m app.mailer test <ваш адрес>
HONESTLOT_SMTP_HOST=postbox.cloud.yandex.net
HONESTLOT_SMTP_PORT=465
HONESTLOT_SMTP_USER=
HONESTLOT_SMTP_PASSWORD=
HONESTLOT_SMTP_FROM=info@honestlot.ru
# Куда пойдут ответы, если не на FROM (пусто - на FROM)
HONESTLOT_SMTP_REPLY_TO=
# Ссылки на оферту и политику ПДн у галочки согласия. Пусто - свои страницы /offer и /privacy
HONESTLOT_OFFER_URL=
HONESTLOT_PRIVACY_URL=
# Реквизиты продавца для /requisites (app/site.py) - только здесь, не в git (репозиторий
# публичный). ФИО с пробелами: bash miniapp/set_env.sh "HONESTLOT_SELLER_NAME=Фамилия Имя Отчество"
HONESTLOT_SELLER_NAME=
HONESTLOT_SELLER_INN=
# Контактный e-mail на страницах сайта (пусто - info@honestlot.ru)
HONESTLOT_CONTACT_EMAIL=
# До какого дня включительно (по Москве) новые подписчики получают раннюю цену (пусто - 2026-12-31);
# получившие сохраняют её, пока подписка не прерывалась
HONESTLOT_EARLY_UNTIL=
